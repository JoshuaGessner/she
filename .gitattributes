# TEC-002: "Git LFS for .blend, .png over ~1MB, .wav, .ogg — set this up
# *before* art lands, not after." Retrofitting LFS means rewriting history.
#
# LFS tracks by pattern, not by size, so the ~1MB threshold in TEC-002 is not
# expressible here. Tracking the whole extension is the correct trade: a small
# UI sprite in LFS costs nothing, a 40MB texture in git history costs forever.
#
# Requires `git lfs install --local` in each clone (already run in this one).

# Source art
*.blend    filter=lfs diff=lfs merge=lfs -text
*.blend1   filter=lfs diff=lfs merge=lfs -text
*.psd      filter=lfs diff=lfs merge=lfs -text

# Textures and images
*.png      filter=lfs diff=lfs merge=lfs -text
*.jpg      filter=lfs diff=lfs merge=lfs -text
*.jpeg     filter=lfs diff=lfs merge=lfs -text
*.tga      filter=lfs diff=lfs merge=lfs -text
*.exr      filter=lfs diff=lfs merge=lfs -text
*.hdr      filter=lfs diff=lfs merge=lfs -text

# Meshes — .glb is binary; .gltf is JSON and stays in git
*.glb      filter=lfs diff=lfs merge=lfs -text
*.fbx      filter=lfs diff=lfs merge=lfs -text

# Audio
*.wav      filter=lfs diff=lfs merge=lfs -text
*.ogg      filter=lfs diff=lfs merge=lfs -text
*.mp3      filter=lfs diff=lfs merge=lfs -text
*.flac     filter=lfs diff=lfs merge=lfs -text

# Fonts
*.ttf      filter=lfs diff=lfs merge=lfs -text
*.otf      filter=lfs diff=lfs merge=lfs -text

# Godot's text formats diff acceptably and must stay out of LFS.
# .uid files are engine-generated — never hand-edit them (TEC-002).
*.gd       text eol=lf
*.gdshader text eol=lf
*.tscn     text eol=lf
*.tres     text eol=lf
*.godot    text eol=lf
*.import   text eol=lf
*.uid      text eol=lf
*.gltf     text eol=lf
*.svg      text eol=lf
