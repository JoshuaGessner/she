; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="SHE"
config/description="A first-person fantasy extraction roguelite for 1-4 players."
config/version="0.1.0"
config/features=PackedStringArray("4.7", "Forward Plus")
run/main_scene="res://levels/dev/movement_gym.tscn"

[autoload]

Config="*res://autoload/config.gd"
AudioDirector="*res://autoload/audio_director.gd"

[debug]

gdscript/warnings/shadowed_variable=2
gdscript/warnings/untyped_declaration=2
gdscript/warnings/inferred_declaration=1
gdscript/warnings/unsafe_cast=1

[rendering]

; Required to export macOS for arm64 or universal — Godot refuses the preset
; without it (ADR-086). Costs nothing here: the project has no imported
; textures at all, so nothing is actually compressed into ETC2/ASTC. It does
; NOT touch the renderer; `renderer/rendering_method` stays absent, which is
; how ADR-052's Forward+ lock is expressed (see tools/check_project.py).
textures/vram_compression/import_etc2_astc=true

[internationalization]

; ADR-084 closes Q104: item text is translation *keys*, and this is the table
; that makes that free rather than a promise. `TEC-006` warned the retrofit is
; painful; at ten items it costs one CSV, and it never gets cheaper than this.
; `en.en.translation` is generated from `en.csv` by the importer.
locale/translations=PackedStringArray("res://data/locale/en.en.translation")

[input]

