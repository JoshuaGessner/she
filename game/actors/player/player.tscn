[ext_resource type="Script" path="res://components/stamina.gd" id="2_stamina"]
[ext_resource type="Script" path="res://components/carried_weight.gd" id="3_weight"]
[ext_resource type="Script" path="res://components/health.gd" id="4_health"]
[ext_resource type="Script" path="res://components/hurtbox.gd" id="5_hurtbox"]
[ext_resource type="Script" path="res://actors/player/melee_weapon.gd" id="6_weapon"]
[ext_resource type="Script" path="res://components/hitbox.gd" id="7_hitbox"]
[ext_resource type="Script" path="res://components/clamor_source.gd" id="8_clamor"]
