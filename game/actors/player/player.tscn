[ext_resource type="Script" path="res://components/inventory.gd" id="10_inventory"]

; local_to_scene, and this is load-bearing rather than tidy. `_apply_stance`
; mutates this shape every frame a player crouches. Shared across instances —
; which is Godot's default for a scene sub-resource — one player crouching
; silently resizes every other player's collider *and* hurtbox. Invisible in
; single-player; arrived the moment `M1-T05` put two bodies in a level.
[sub_resource type="CapsuleShape3D" id="CapsuleShape3D_body"]
resource_local_to_scene = true
radius = 0.35
height = 1.8

[sub_resource type="CapsuleMesh" id="CapsuleMesh_body"]
resource_local_to_scene = true
radius = 0.35
height = 1.8

; Lighter than every enemy state (0.20–0.52) and darker than the telegraph
; flash (0.95), so a teammate is never mistaken for a threat at a glance.
; ART-005 spends saturated colour on treasure, so the distinction is value.
[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_body"]
resource_local_to_scene = true
albedo_color = Color(0.72, 0.71, 0.7, 1)
roughness = 1.0

[sub_resource type="SphereShape3D" id="SphereShape3D_arc"]
radius = 1.1

[sub_resource type="BoxMesh" id="BoxMesh_blade"]
size = Vector3(0.07, 0.07, 0.85)

[sub_resource type="StandardMaterial3D" id="StandardMaterial3D_blade"]
albedo_color = Color(0.78, 0.78, 0.8, 1)

[node name="Player" type="CharacterBody3D"]
collision_layer = 2
collision_mask = 1
script = ExtResource("1_player")

[node name="CollisionShape3D" type="CollisionShape3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("CapsuleShape3D_body")

[node name="Body" type="MeshInstance3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
mesh = SubResource("CapsuleMesh_body")
surface_material_override/0 = SubResource("StandardMaterial3D_body")

[node name="Head" type="Node3D" parent="."]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 1.62, 0)

[node name="Camera3D" type="Camera3D" parent="Head"]

[node name="InkPass" type="MeshInstance3D" parent="Head/Camera3D"]
script = ExtResource("9_ink")

[node name="Weapon" type="Node3D" parent="Head"]
script = ExtResource("6_weapon")

[node name="Model" type="Node3D" parent="Head/Weapon"]

[node name="Blade" type="MeshInstance3D" parent="Head/Weapon/Model"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -0.35)
mesh = SubResource("BoxMesh_blade")
surface_material_override/0 = SubResource("StandardMaterial3D_blade")

[node name="Hitbox" type="Area3D" parent="Head/Weapon"]
collision_layer = 0
collision_mask = 16
monitoring = false
script = ExtResource("7_hitbox")

[node name="CollisionShape3D" type="CollisionShape3D" parent="Head/Weapon/Hitbox"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0, -1.1)
shape = SubResource("SphereShape3D_arc")

[node name="Stamina" type="Node" parent="."]
script = ExtResource("2_stamina")

[node name="CarriedWeight" type="Node" parent="."]
script = ExtResource("3_weight")

; The bag (`M2-T01`). Holds `ItemInstance`s, which are `RefCounted` and not
; `Resource` (ADR-084) — so unlike the capsule above there is no sub-resource
; here for Godot to share between two players. Weight reaches `CarriedWeight`
; through `Player`, never sideways from one component to another.
[node name="Inventory" type="Node" parent="."]
script = ExtResource("10_inventory")

[node name="Health" type="Node" parent="."]
script = ExtResource("4_health")

[node name="ClamorSource" type="Node3D" parent="." groups=["clamor_sources"]]
script = ExtResource("8_clamor")

[node name="Hurtbox" type="Area3D" parent="."]
collision_layer = 8
collision_mask = 0
monitoring = false
script = ExtResource("5_hurtbox")

[node name="CollisionShape3D" type="CollisionShape3D" parent="Hurtbox"]
transform = Transform3D(1, 0, 0, 0, 1, 0, 0, 0, 1, 0, 0.9, 0)
shape = SubResource("CapsuleShape3D_body")
