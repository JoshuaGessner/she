; Godot writes .gd, .tscn and .tres with tabs and LF. Matching that exactly
; keeps editor-saved and hand-written files from producing whitespace diffs.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{gd,tscn,tres,godot,gdshader,cfg}]
indent_style = tab
indent_size = 4

[*.{py,yml,yaml,json,md}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
